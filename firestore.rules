rules_version = '2';

// GeldScan – only results are stored (no images, no audio, no personal data).
// users/{uid}/scans/{id}  one document per note recognised with at least 90 % certainty
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Old user document from the points version: may only be deleted ("Wis al mijn gegevens").
      allow delete: if isOwner(uid);

      match /scans/{scanId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['label', 'valueEuro', 'confidence', 'mode', 'createdAt'])
          && request.resource.data.keys().hasAll(['label', 'valueEuro', 'confidence', 'mode', 'createdAt'])
          && request.resource.data.label is string && request.resource.data.label.size() <= 40
          && request.resource.data.valueEuro in [5, 10, 20, 50, 100, 200, 500]
          && request.resource.data.confidence is number
          && request.resource.data.confidence >= 0.9 && request.resource.data.confidence <= 1
          && request.resource.data.mode in ['ask', 'counting']
          && request.resource.data.createdAt == request.time;

        // Scans are never edited; the owner may delete them ("Wis al mijn gegevens").
        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
