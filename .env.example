# Copy to .env.local (lokaal) en zet dezelfde waarden in Vercel → Settings → Environment Variables.
# Te vinden in Firebase console → Project settings → General → Your apps → Web app.
# Laat leeg om de app zonder Firebase te gebruiken (punten blijven dan op het toestel).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Map met model.json, metadata.json en weights.bin (standaard /model/)
VITE_MODEL_URL=/model/
