# Firebase web config (public by design: it ships to every browser).
# Data is protected by firestore.rules and Firebase Auth authorized domains, not by this key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_MODEL_URL=
